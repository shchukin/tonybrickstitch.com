---
import BaseLayout from "../layouts/BaseLayout.astro";
import Intro from "../components/Intro/Intro.astro";
import Follow from "../components/Follow/Follow.astro";
import AllMods from "../components/AllMods/AllMods.astro";
import { getCollection } from "astro:content";

const modsEntries = await getCollection("mods");
const mods = modsEntries.map((entry) => entry.data);
---

<BaseLayout>
	<Intro />
	<Follow />
	<AllMods mods={mods} />
</BaseLayout>
