---
import BaseLayout from "../layouts/BaseLayout.astro";
import Title from "../components/Title/Title.astro";
import { PATTERNS_LIST, getPatternById, DEFAULT_PATTERN_ID } from "../data/patterns";
import { generateLoomSvg, generateOriginalPatternSvg } from "../utils/loomSvgGenerator";
import { generateWordChart, exportWordChartAsHtml, exportWordChartAsMarkdown } from "../utils/wordChartGenerator";
import { wrapMatrixWithClasp, getClaspColor } from "../utils/claspUtils";
import { formatBeadWeight } from "../utils/beadWeight";
import "../components/Studio/Studio.css";

// 1. Prepare rendered data for ALL patterns at build time so client JS can instantly switch
const renderedPatternsMap: Record<string, any> = {};

PATTERNS_LIST.forEach((pattern) => {
  const { matrix, palette, name, id, description } = pattern;
  const claspData = wrapMatrixWithClasp(matrix);
  const { extendedMatrix, numCols, totalRows, numPatternRows, isClaspRow, getBeadFill } = claspData;
  const totalPatternBeads = numPatternRows * numCols;

  const extendedMatrixFills = extendedMatrix.map((row, rIdx) =>
    row.map((cell, cIdx) => {
      const isClasp = rIdx === 0 || rIdx === extendedMatrix.length - 1;
      if (isClasp) {
        return getClaspColor(cIdx, rIdx === 0 ? "top" : "bottom");
      }
      return palette[cell]?.fill || "#ffffff";
    })
  );

  const colorCounts: Record<string, number> = {};
  Object.keys(palette).forEach((key) => (colorCounts[key] = 0));

  matrix.forEach((row) => {
    row.forEach((cell) => {
      if (colorCounts[cell] !== undefined) colorCounts[cell]++;
      else colorCounts[cell] = 1;
    });
  });

  const newLoomSvg = generateLoomSvg(matrix, palette);
  const originalStyleSvg = generateOriginalPatternSvg(matrix, palette);
  const wordChartData = generateWordChart(matrix, palette);
  const wordChartHtml = exportWordChartAsHtml(matrix, palette);
  const wordChartMd = exportWordChartAsMarkdown(matrix, palette);

  renderedPatternsMap[id] = {
    id,
    name,
    description,
    numCols,
    numPatternRows,
    totalPatternBeads,
    totalPatternBeadsWeight: formatBeadWeight(totalPatternBeads),
    palette,
    colorCounts,
    extendedMatrix,
    extendedMatrixFills,
    newLoomSvg,
    originalStyleSvg,
    wordChartData,
    wordChartHtml,
    wordChartMd,
    matrixCode: `// Pattern ID: ${id} (${name})\nconst patternMatrix = [\n${matrix.map((row, idx) => `  /* Row ${String(idx + 1).padStart(3, " ")} */ [${row.map((c) => `'${c}'`).join(", ")}]`).join(",\n")}\n];`
  };
});

// Determine initial pattern from param or searchParam
const paramId = Astro.params.pattern;
const queryId = Astro.url.searchParams.get("pattern");
const requestedId = paramId || queryId;
const initialPattern = getPatternById(requestedId);
const initialData = renderedPatternsMap[initialPattern.id];

// Helper to check if fill/cell represents white background
function isWhiteColor(cell: string, fill?: string): boolean {
  if (cell === 'f' || cell === 'w' || cell === 'a') return true;
  if (!fill) return false;
  const normalized = fill.trim().toLowerCase();
  return normalized === '#ffffff' || normalized === '#fff' || normalized === 'white';
}
---

<BaseLayout>
  <div class="studio">
    <header class="studio__header">
      <Title as="h1">Studio</Title>
      <p class="studio__description">
        Веб-приложение для работы с схемами и паттернами из бисера (плетение на станке / loom beadwork).
      </p>

      <!-- Pattern Selector Bar -->
      <div class="studio__pattern-selector">
        <span class="studio__pattern-label">Выбор паттерна:</span>
        <div class="studio__pattern-pills">
          {PATTERNS_LIST.map((p) => (
            <button
              type="button"
              data-pattern-id={p.id}
              class={`studio__pattern-pill ${p.id === initialData.id ? 'is-active' : ''}`}
            >
              <span>🎨</span> {p.name} ({p.matrix[0].length}×{p.matrix.length})
            </button>
          ))}
        </div>
      </div>
    </header>

    <!-- SECTION 1: 2D Matrix Analysis -->
    <section class="studio__section">
      <h2 id="studio-section1-title" class="studio__section-title">
        <span>📊</span> 1. Текущий паттерн: {initialData.name} (Двухмерный массив + Clasp)
      </h2>
      <p id="studio-section1-desc" class="studio__section-desc">
        {initialData.description} Источником истины является массив <code>matrix[{initialData.numPatternRows}][{initialData.numCols}]</code>.
        Вес рассчитан из стандарта Miyuki Delica 11/0 (10 г = 1850 шт.).
      </p>

      <div id="studio-stats" class="studio__stats">
        <div class="studio__stats-row studio__stats-row--general">
          <div class="studio__stat-card">
            <div class="studio__stat-label">Размер схемы</div>
            <div class="studio__stat-value">{initialData.numCols} × {initialData.numPatternRows} (+2 clasp)</div>
          </div>
          <div class="studio__stat-card">
            <div class="studio__stat-label">Бусин в схеме</div>
            <div class="studio__stat-value">{initialData.totalPatternBeads} шт. ({initialData.totalPatternBeadsWeight})</div>
          </div>
        </div>
        <div class="studio__stats-row studio__stats-row--colors">
          {Object.entries(initialData.palette)
            .sort(([keyA], [keyB]) => keyA.localeCompare(keyB))
            .map(([key, colorDef]: [string, any]) => {
              const count = initialData.colorCounts[key] || 0;
              return (
                <div class="studio__stat-card">
                  <div class="studio__stat-label">Алиас '{key}' ({colorDef.fill})</div>
                  <div class="studio__stat-value">{count} шт. ({formatBeadWeight(count)})</div>
                </div>
              );
            })}
        </div>
      </div>

      <!-- Tabs for Matrix View -->
      <div class="studio__tabs">
        <button type="button" class="studio__tab-btn is-active" data-tab="grid">Интерактивная сетка (Визуал)</button>
        <button type="button" class="studio__tab-btn" data-tab="code">Код массива (JS Array)</button>
      </div>

      <!-- Tab Content: Visual Grid -->
      <div id="tab-grid" class="studio__tab-content">
        <div class="studio__matrix-container">
          <div
            id="studio-matrix-grid"
            class="studio__matrix-grid"
            style={`grid-template-columns: repeat(${initialData.numCols}, 22px);`}
          >
            {initialData.extendedMatrix.map((row: string[], rIdx: number) =>
              row.map((cell: string, cIdx: number) => {
                const isClasp = rIdx === 0 || rIdx === initialData.extendedMatrix.length - 1;
                const fill = initialData.extendedMatrixFills[rIdx][cIdx];
                const textColor = isClasp ? '#ffffff' : (isWhiteColor(cell, fill) ? '#000000' : '#ffffff');
                return (
                  <div
                    class={`studio__matrix-cell ${isClasp ? 'studio__matrix-cell--clasp' : `studio__matrix-cell--${cell}`}`}
                    style={`background-color: ${fill}; color: ${textColor}; ${isClasp ? 'text-shadow: 0 1px 2px rgba(0,0,0,0.8); font-weight: bold;' : ''}`}
                    title={isClasp ? `Ряд clasp, Колонка ${cIdx + 1}: Clasp` : `Ряд ${rIdx}, Колонка ${cIdx + 1}: Цвет ${cell.toUpperCase()}`}
                  >
                    {isClasp ? 'x' : cell}
                  </div>
                );
              })
            )}
          </div>
        </div>
      </div>

      <!-- Tab Content: Raw JS Code -->
      <div id="tab-code" class="studio__tab-content" style="display: none;">
        <pre class="studio__code-block"><code id="studio-code-block">{initialData.matrixCode}</code></pre>
      </div>
    </section>

    <!-- SECTION 2: Newly Generated SVG Loom Grid -->
    <section class="studio__section">
      <h2 class="studio__section-title">
        <span>🧵</span> 2. Сгенерированное SVG изображение (Сетка для станка)
      </h2>
      <p id="studio-section2-desc" class="studio__section-desc">
        Векторная схема для станочного плетения ({initialData.name}): с нитями основы, разметкой рядов (включая <code>clasp</code> строки со случайным цветным бисером), нумерацией колонок, весом в граммах и легендой цветов.
      </p>

      <div id="studio-loom-svg-container" class="studio__svg-wrapper">
        <Fragment set:html={initialData.newLoomSvg} />
      </div>

      <div class="studio__actions">
        <button id="download-svg-btn" type="button" class="studio__btn">
          <span>💾</span> Скачать SVG (Сетка для станка)
        </button>
      </div>
    </section>

    <!-- SECTION 3: Word Chart (Row-by-Row Text Instructions) -->
    <section class="studio__section">
      <h2 class="studio__section-title">
        <span>📝</span> 3. Word Chart (Словесная инструкция по рядам)
      </h2>
      <p class="studio__section-desc">
        Текстовая схема для мастериц, позволяющая набирать бисер по рядам сгруппированными сериями вместо штучного счёта.
      </p>

      <div class="word-chart">
        <div class="word-chart__toolbar">
          <div class="studio__tabs" style="margin-bottom: 0; border: none; padding: 0;">
            <button type="button" class="studio__tab-btn is-active" data-wc-tab="visual">Бэйджи (Визуал)</button>
            <button type="button" class="studio__tab-btn" data-wc-tab="text">Печатная версия (&lt;pre&gt;)</button>
            <button type="button" class="studio__tab-btn" data-wc-tab="md">Markdown (для Figma)</button>
          </div>

          <div class="word-chart__search">
            <input id="wc-search-input" type="text" class="word-chart__input" placeholder="Перейти к ряду (напр. 15)..." />
            <button id="copy-wc-btn" type="button" class="studio__btn studio__btn--secondary" style="padding: 0.45rem 0.85rem; font-size: 0.85rem;">
              <span>📋</span> Копировать Word Chart
            </button>
          </div>
        </div>

        <!-- Word Chart Visual List -->
        <div id="wc-visual-tab" class="word-chart__list">
          {initialData.wordChartData.rows.map((row: any) => (
            <div class={`word-chart__row ${row.isClasp ? 'word-chart__row--clasp' : ''}`} data-row-num={row.rowLabel}>
              <div class={`word-chart__row-num ${row.isClasp ? 'word-chart__row-num--clasp' : ''}`}>
                {row.rowLabel}:
              </div>
              <div class="word-chart__runs">
                {row.runs.map((run: any) => {
                  const colorDef = initialData.palette[run.color];
                  const fill = colorDef?.fill;
                  const textColor = isWhiteColor(run.color, fill) ? '#000000' : '#ffffff';
                  const badgeStyle = fill && !run.isClasp ? `background-color: ${fill}; color: ${textColor};` : '';
                  return (
                    <span class={`word-chart__badge word-chart__badge--${run.color}`} style={badgeStyle}>
                      <strong>({run.count})</strong>{run.isClasp ? 'Any / Culled beads' : run.color.toUpperCase()}
                    </span>
                  );
                })}
              </div>
            </div>
          ))}
        </div>

        <!-- Word Chart Plain Text / Pre View -->
        <div id="wc-text-tab" style="display: none;">
          <pre class="word-chart__text-view"><code id="wc-text-code" set:html={initialData.wordChartHtml} /></pre>
        </div>

        <!-- Word Chart Markdown View (for Figma) -->
        <div id="wc-md-tab" style="display: none;">
          <pre class="word-chart__text-view"><code id="wc-md-code">{initialData.wordChartMd}</code></pre>
        </div>
      </div>
    </section>

    <!-- SECTION 4: Original-style Pattern SVG generated dynamically from array -->
    <section class="studio__section">
      <h2 id="studio-section4-title" class="studio__section-title">
        <span>🖼️</span> 4. Исходное SVG изображение ({initialData.name})
      </h2>
      <p id="studio-section4-desc" class="studio__section-desc">
        Векторная схема в оригинальном формате (на чёрном фоне, без нитей и меток), сгенерированная напрямую из массива <code>{initialData.id}</code> с добавленными разноцветными строками <code>clasp</code>.
      </p>
      <div id="studio-original-svg-container" class="studio__svg-wrapper">
        <Fragment set:html={initialData.originalStyleSvg} />
      </div>
    </section>
  </div>

  <!-- Embed JSON data for all patterns for instant client-side switching -->
  <script id="patterns-data" type="application/json" is:inline set:html={JSON.stringify(renderedPatternsMap)}></script>
</BaseLayout>

<script>
  // Retrieve pre-rendered data map for all patterns
  const patternsDataScript = document.getElementById('patterns-data');
  const PATTERNS_DATA = patternsDataScript ? JSON.parse(patternsDataScript.textContent || '{}') : {};

  function isWhiteColorClient(cell: string, fill?: string): boolean {
    if (cell === 'f' || cell === 'w' || cell === 'a') return true;
    if (!fill) return false;
    const normalized = fill.trim().toLowerCase();
    return normalized === '#ffffff' || normalized === '#fff' || normalized === 'white';
  }

  // Function to format bead weight helper in client JS
  function formatBeadWeight(count: number): string {
    const grams = count / 185;
    if (grams === 0) return "0 г";
    const rounded = Math.round(grams * 10) / 10;
    return `~${rounded} г`;
  }

  // Active pattern state
  let currentPatternId = 'bezier-gold';

  function updateStudioDOM(patternId: string, updateUrl = true) {
    const data = PATTERNS_DATA[patternId];
    if (!data) return;

    currentPatternId = patternId;

    // 1. Update pattern pills active state
    document.querySelectorAll('[data-pattern-id]').forEach((btn) => {
      if (btn.getAttribute('data-pattern-id') === patternId) {
        btn.classList.add('is-active');
      } else {
        btn.classList.remove('is-active');
      }
    });

    // 2. Section 1 Titles & Descriptions
    const sec1Title = document.getElementById('studio-section1-title');
    if (sec1Title) sec1Title.innerHTML = `<span>📊</span> 1. Текущий паттерн: ${data.name} (Двухмерный массив + Clasp)`;

    const sec1Desc = document.getElementById('studio-section1-desc');
    if (sec1Desc) sec1Desc.innerHTML = `${data.description} Источником истины является массив <code>matrix[${data.numPatternRows}][${data.numCols}]</code>. Вес рассчитан из стандарта Miyuki Delica 11/0 (10 г = 1850 шт.).`;

    // 3. Stats Cards
    const statsContainer = document.getElementById('studio-stats');
    if (statsContainer) {
      let colorsHtml = '';
      Object.entries(data.palette)
        .sort(([keyA], [keyB]) => keyA.localeCompare(keyB))
        .forEach(([key, colorDef]: [string, any]) => {
          const count = data.colorCounts[key] || 0;
          colorsHtml += `
            <div class="studio__stat-card">
              <div class="studio__stat-label">Алиас '${key}' (${colorDef.fill})</div>
              <div class="studio__stat-value">${count} шт. (${formatBeadWeight(count)})</div>
            </div>
          `;
        });

      statsContainer.innerHTML = `
        <div class="studio__stats-row studio__stats-row--general">
          <div class="studio__stat-card">
            <div class="studio__stat-label">Размер схемы</div>
            <div class="studio__stat-value">${data.numCols} × ${data.numPatternRows} (+2 clasp)</div>
          </div>
          <div class="studio__stat-card">
            <div class="studio__stat-label">Бусин в схеме</div>
            <div class="studio__stat-value">${data.totalPatternBeads} шт. (${data.totalPatternBeadsWeight})</div>
          </div>
        </div>
        <div class="studio__stats-row studio__stats-row--colors">
          ${colorsHtml}
        </div>
      `;
    }

    // 4. Matrix Grid
    const matrixGrid = document.getElementById('studio-matrix-grid');
    if (matrixGrid) {
      matrixGrid.style.gridTemplateColumns = `repeat(${data.numCols}, 22px)`;
      let gridHtml = '';
      data.extendedMatrix.forEach((row: string[], rIdx: number) => {
        row.forEach((cell: string, cIdx: number) => {
          const isClasp = rIdx === 0 || rIdx === data.extendedMatrix.length - 1;
          const fill = data.extendedMatrixFills ? data.extendedMatrixFills[rIdx][cIdx] : '#475569';
          const textColor = isClasp ? '#ffffff' : (isWhiteColorClient(cell, fill) ? '#000000' : '#ffffff');
          const cellClass = isClasp ? 'studio__matrix-cell--clasp' : `studio__matrix-cell--${cell}`;
          const cellStyle = `style="background-color: ${fill}; color: ${textColor}; ${isClasp ? 'text-shadow: 0 1px 2px rgba(0,0,0,0.8); font-weight: bold;' : ''}"`;
          const title = isClasp ? `Ряд clasp, Колонка ${cIdx + 1}: Clasp` : `Ряд ${rIdx}, Колонка ${cIdx + 1}: Цвет ${cell.toUpperCase()}`;
          gridHtml += `<div class="studio__matrix-cell ${cellClass}" ${cellStyle} title="${title}">${isClasp ? 'x' : cell}</div>`;
        });
      });
      matrixGrid.innerHTML = gridHtml;
    }

    // 5. Code Block
    const codeBlock = document.getElementById('studio-code-block');
    if (codeBlock) codeBlock.textContent = data.matrixCode;

    // 6. Section 2 Loom SVG
    const sec2Desc = document.getElementById('studio-section2-desc');
    if (sec2Desc) sec2Desc.innerHTML = `Векторная схема для станочного плетения (${data.name}): с нитями основы, разметкой рядов (включая <code>clasp</code> строки со случайным цветным бисером), нумерацией колонок, весом в граммах и легендой цветов.`;

    const loomSvgContainer = document.getElementById('studio-loom-svg-container');
    if (loomSvgContainer) loomSvgContainer.innerHTML = data.newLoomSvg;

    // 7. Word Chart
    const wcVisualTab = document.getElementById('wc-visual-tab');
    if (wcVisualTab) {
      let wcRowsHtml = '';
      data.wordChartData.rows.forEach((row: any) => {
        const rowClass = row.isClasp ? 'word-chart__row word-chart__row--clasp' : 'word-chart__row';
        const numClass = row.isClasp ? 'word-chart__row-num word-chart__row-num--clasp' : 'word-chart__row-num';
        let badgesHtml = '';
        row.runs.forEach((run: any) => {
          const colorDef = data.palette[run.color];
          const fill = colorDef?.fill;
          const textColor = isWhiteColorClient(run.color, fill) ? '#000000' : '#ffffff';
          const badgeStyle = fill && !run.isClasp ? `style="background-color: ${fill}; color: ${textColor};"` : '';
          badgesHtml += `<span class="word-chart__badge word-chart__badge--${run.color}" ${badgeStyle}><strong>(${run.count})</strong>${run.isClasp ? 'Any / Culled beads' : run.color.toUpperCase()}</span>`;
        });
        wcRowsHtml += `<div class="${rowClass}" data-row-num="${row.rowLabel}"><div class="${numClass}">${row.rowLabel}:</div><div class="word-chart__runs">${badgesHtml}</div></div>`;
      });
      wcVisualTab.innerHTML = wcRowsHtml;
    }

    const wcTextCode = document.getElementById('wc-text-code');
    if (wcTextCode) wcTextCode.innerHTML = data.wordChartHtml;

    const wcMdCode = document.getElementById('wc-md-code');
    if (wcMdCode) wcMdCode.textContent = data.wordChartMd;

    // 8. Section 4 Original SVG
    const sec4Title = document.getElementById('studio-section4-title');
    if (sec4Title) sec4Title.innerHTML = `<span>🖼️</span> 4. Исходное SVG изображение (${data.name})`;

    const sec4Desc = document.getElementById('studio-section4-desc');
    if (sec4Desc) sec4Desc.innerHTML = `Векторная схема в оригинальном формате (на чёрном фоне, без нитей и меток), сгенерированная напрямую из массива <code>${data.id}</code> с добавленными разноцветными строками <code>clasp</code>.`;

    const origSvgContainer = document.getElementById('studio-original-svg-container');
    if (origSvgContainer) origSvgContainer.innerHTML = data.originalStyleSvg;

    // 9. Update URL query parameter
    if (updateUrl && window.history) {
      const url = new URL(window.location.href);
      url.searchParams.set('pattern', patternId);
      window.history.replaceState({}, '', url.toString());
    }
  }

  // Handle click on pattern pills
  document.querySelectorAll('[data-pattern-id]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const patternId = btn.getAttribute('data-pattern-id');
      if (patternId) {
        updateStudioDOM(patternId, true);
      }
    });
  });

  // On page load, check URL parameter
  const urlParams = new URLSearchParams(window.location.search);
  const initialUrlPattern = urlParams.get('pattern');
  if (initialUrlPattern && PATTERNS_DATA[initialUrlPattern]) {
    updateStudioDOM(initialUrlPattern, false);
  }

  // Tab switching logic for Matrix
  const tabBtns = document.querySelectorAll('[data-tab]');
  const tabContents = {
    grid: document.getElementById('tab-grid'),
    code: document.getElementById('tab-code'),
  };

  tabBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const tabName = btn.getAttribute('data-tab');
      tabBtns.forEach((b) => b.classList.remove('is-active'));
      btn.classList.add('is-active');
      Object.entries(tabContents).forEach(([name, el]) => {
        if (el) el.style.display = name === tabName ? 'block' : 'none';
      });
    });
  });

  // Tab switching logic for Word Chart (visual, text, md)
  const wcTabBtns = document.querySelectorAll('[data-wc-tab]');
  const wcTabContents = {
    visual: document.getElementById('wc-visual-tab'),
    text: document.getElementById('wc-text-tab'),
    md: document.getElementById('wc-md-tab'),
  };

  wcTabBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const tabName = btn.getAttribute('data-wc-tab');
      wcTabBtns.forEach((b) => b.classList.remove('is-active'));
      btn.classList.add('is-active');
      Object.entries(wcTabContents).forEach(([name, el]) => {
        if (el) el.style.display = name === tabName ? 'block' : 'none';
      });
    });
  });

  // Word Chart Search / Filter by Row
  const wcSearchInput = document.getElementById('wc-search-input') as HTMLInputElement | null;
  wcSearchInput?.addEventListener('input', (e) => {
    const val = (e.target as HTMLInputElement).value.trim();
    const rows = document.querySelectorAll('.word-chart__row');
    rows.forEach((row) => {
      const rowNum = row.getAttribute('data-row-num');
      if (!val || (rowNum && rowNum.includes(val))) {
        (row as HTMLElement).style.display = 'flex';
      } else {
        (row as HTMLElement).style.display = 'none';
      }
    });
  });

  // Copy Word Chart to Clipboard
  const copyWcBtn = document.getElementById('copy-wc-btn');
  copyWcBtn?.addEventListener('click', async () => {
    const activeTab = document.querySelector('[data-wc-tab].is-active')?.getAttribute('data-wc-tab');
    if (activeTab === 'md') {
      const mdCodeEl = document.querySelector('#wc-md-tab code');
      const textToCopy = mdCodeEl?.textContent || '';
      await navigator.clipboard.writeText(textToCopy);
    } else {
      let htmlContent = '';
      let textContent = '';
      if (activeTab === 'text') {
        const codeEl = document.querySelector('#wc-text-tab code');
        htmlContent = codeEl?.innerHTML || '';
        textContent = (codeEl as HTMLElement)?.innerText || codeEl?.textContent || '';
      } else {
        const visualEl = document.getElementById('wc-visual-tab');
        htmlContent = visualEl?.innerHTML || '';
        textContent = visualEl?.innerText || visualEl?.textContent || '';
      }

      try {
        const htmlBlob = new Blob([htmlContent], { type: 'text/html' });
        const textBlob = new Blob([textContent], { type: 'text/plain' });
        await navigator.clipboard.write([
          new ClipboardItem({ 'text/html': htmlBlob, 'text/plain': textBlob }),
        ]);
      } catch (err) {
        await navigator.clipboard.writeText(textContent);
      }
    }

    if (copyWcBtn) {
      const origText = copyWcBtn.innerHTML;
      copyWcBtn.innerHTML = '<span>✅</span> Скопировано!';
      setTimeout(() => {
        copyWcBtn.innerHTML = origText;
      }, 2000);
    }
  });

  // SVG Download Logic
  const downloadBtn = document.getElementById('download-svg-btn');
  downloadBtn?.addEventListener('click', () => {
    const svgEl = document.querySelector('#studio-loom-svg-container svg');
    if (!svgEl) return;
    const svgData = new XMLSerializer().serializeToString(svgEl);
    const blob = new Blob([svgData], { type: 'image/svg+xml;charset=utf-8' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `loom-beadwork-${currentPatternId}.svg`;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
  });
</script>
