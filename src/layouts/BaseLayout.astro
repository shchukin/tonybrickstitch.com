---
import '../styles/styles.css';
---
<!DOCTYPE html>
<html lang="en" itemscope itemtype="https://schema.org/Thing">
    <head>
        <meta charset="utf-8">
        <title>Tony Brick Stitch</title>
        <meta name="description" content="Hi, I’m Tony! I create things using seed beads.">

        <!-- schema.org (google plus) -->
        <meta itemprop="url" content="https://tonybrickstitch.com">
        <meta itemprop="image" content="https://tonybrickstitch.com/favicon/social-media-image-1200x675.jpg">
        <meta itemprop="name" content="Tony Brick Stitch">
        <meta itemprop="description" content="Hi, I’m Tony! I create things using seed beads.">

        <!-- ogp.me (facebook & vk) -->
        <meta property="og:type" content="website">
        <meta property="og:url" content="https://tonybrickstitch.com">
        <meta property="og:image" content="https://tonybrickstitch.com/favicon/social-media-image-1200x675.jpg">
        <meta property="og:image:width" content="1200">
        <meta property="og:image:height" content="675">
        <meta property="og:title" content="Tony Brick Stitch">
        <meta property="og:description" content="Hi, I’m Tony! I create things using seed beads.">

        <!-- favicon -->
        <link rel="apple-touch-icon" sizes="180x180" href="favicon/apple-touch-icon.png">
        <link rel="icon" type="image/png" sizes="32x32" href="favicon/favicon-32x32.png">
        <link rel="icon" type="image/png" sizes="16x16" href="favicon/favicon-16x16.png">
        <link rel="mask-icon" href="favicon/safari-pinned-tab.svg" color="#FFFFFF">

        <!-- manifest -->
        <link rel="manifest" href="manifest.json">
        <meta name="theme-color" content="#FFFFFF">
        <meta name="msapplication-config" content="../browserconfig.xml">
        <meta name="msapplication-TileColor" content="#FFFFFF">

        <!-- assets -->
        <meta name="viewport" content="width=device-width, initial-scale=1">
    </head>
    <body>

        <div class="page container">
            <slot />
        </div>

    </body>
</html>
