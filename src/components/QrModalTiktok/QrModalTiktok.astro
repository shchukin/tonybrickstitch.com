---
import './QrModalTiktok.css';
import Image from "../Image/Image.astro";
import logoImg from '../../assets/images/logo.png';
import tiktokLogo from '../../assets/images/tiktok-logo.png';
import HystModal from "../HystModal/HystModal.astro";
import Window from "../Window/Window.astro";
import tiktokBgJpg from './tiktok-background.jpg?url';
import type { SocialNetworkData } from "../../data/socialNetworks";

interface Props {
	data: SocialNetworkData;
}

const { data } = Astro.props;
const { id, qrImage, title = 'TonyBrickStitch', username, label, link } = data;
---

<link rel="preload" href={tiktokBgJpg} as="image" type="image/jpeg" />

<HystModal id={id}>
	<Window>
		<div class="qr-modal-tiktok">
			<Image class="qr-modal-tiktok__logo" src={logoImg} width="106" height="106" alt="Tony Brick Stitch Logo" />
			<a class="qr-modal-tiktok__title" href={link} target="_blank">
				{title}
			</a>
			<a class="qr-modal-tiktok__username" href={link} target="_blank">
				@<span class="qr-modal-tiktok__hover">{username}</span>
			</a>
			<img class="qr-modal-tiktok__image" src={qrImage} alt={`QR code for ${label}`} />
			<Image class="qr-modal-tiktok__platform-logo" src={tiktokLogo} width="182" height="76" alt="TikTok logo" />
		</div>
	</Window>
</HystModal>
