---
import './QrModalTiktok.css';
import { Image } from 'astro:assets';
import logoImg from '../../assets/images/logo.png';
import tiktokLogo from '../../assets/images/tiktok-logo.png';
import Link from "../Link/Link.astro";
import HystModal from "../HystModal/HystModal.astro";
import Window from "../Window/Window.astro";
import type { SocialNetworkData } from "../../data/socialNetworks";

interface Props {
	data: SocialNetworkData;
}

const { data } = Astro.props;
const { id, qrImage, title = 'TonyBrickStitch', username, label, link } = data;
---

<HystModal id={id}>
	<Window>
		<div class="qr-modal-tiktok">
			<Image class="qr-modal-tiktok__logo" src={logoImg} alt="Tony Brick Stitch Logo" />
			<div class="qr-modal-tiktok__title">
				<Link invertedTextAlike href={link} target="_blank">{title}</Link>
			</div>
			<div class="qr-modal-tiktok__username">
				<Link invertedTextAlike href={link} target="_blank">{username}</Link>
			</div>
			<img class="qr-modal-tiktok__image" src={qrImage} alt={`QR code for ${label}`} />
			<Image class="qr-modal-tiktok__platform-logo" src={tiktokLogo} alt="" />
		</div>
	</Window>
</HystModal>
