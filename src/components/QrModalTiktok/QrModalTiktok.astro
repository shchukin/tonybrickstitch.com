---
import './QrModalTiktok.css';
import { Image } from 'astro:assets';
import logoImg from '../../assets/images/logo.png';

interface Props {
	qrImage: string;
	username: string;
	label: string;
}

const { qrImage, username, label } = Astro.props;
---

<div class="qr-modal-tiktok">
	<Image class="qr-modal-tiktok__logo" src={logoImg} alt="Tony Brick Stitch Logo" />
	<div class="qr-modal-tiktok__extra">foobar</div>
	<img class="qr-modal-tiktok__image" src={qrImage} alt={`QR code for ${label}`} />
	<div class="qr-modal-tiktok__username">{username}</div>
</div>
