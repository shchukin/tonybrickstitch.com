---
import './Tool.css';
import Link from '../Link/Link.astro';
import Wysiwyg from '../Wysiwyg/Wysiwyg.astro';
import Button from '../Button/Button.astro';
import Label from '../Label/Label.astro';
import Image from '../Image/Image.astro';
import type { ToolData } from '../../types/tool';

interface Props extends ToolData {}

const {
	alias,
	title,
	description,
	gallery = [],
	license,
	downloadLayout = 'buttons',
	downloads = [],
	downloadFiles,
} = Astro.props;

const mainImage = gallery[0];
const subImages = gallery.slice(1, 4); // max 3 thumbnails (indices 1, 2, 3)
const hiddenImages = gallery.slice(4); // remaining images (indices 4+)
const remainingCount = gallery.length > 4 ? gallery.length - 4 : 0;

function isExternalUrl(url: string): boolean {
	return url.startsWith('http://') || url.startsWith('https://') || url.startsWith('//');
}
---

<article class="tool">
	<div class="tool__gallery pswp-gallery" id={`gallery-${alias}`}>
		{mainImage && (
			<a
				href={mainImage.src}
				data-pswp-width={mainImage.width}
				data-pswp-height={mainImage.height}
				class="tool__preview"
			>
				<Image
					class="tool__image"
					src={mainImage}
					width="280"
					height="210"
					alt={`Preview image for tool: ${title}`}
				/>
			</a>
		)}
		{subImages.length > 0 && (
			<div class="tool__thumbs">
				{subImages.map((img, idx) => {
					const isLastThumb = idx === 2;
					const showOverlay = isLastThumb && remainingCount > 0;
					return (
						<a
							href={img.src}
							data-pswp-width={img.width}
							data-pswp-height={img.height}
							class="tool__thumb-link"
						>
							<Image
								class="tool__thumb-image"
								src={img}
								width="90"
								height="68"
								alt={`Thumbnail ${idx + 2} for ${title}`}
							/>
							{showOverlay && (
								<span class="tool__thumb-overlay">
									+{remainingCount}
								</span>
							)}
						</a>
					);
				})}
			</div>
		)}
		{hiddenImages.map((img) => (
			<a
				href={img.src}
				data-pswp-width={img.width}
				data-pswp-height={img.height}
				style="display: none;"
			/>
		))}
	</div>
	<div class="tool__body">
		<h3 class="tool__heading">
			{title}
		</h3>
		<div class="tool__description">
			<Wysiwyg smaller set:html={description} />
		</div>
	</div>
	<div class="tool__sidebar">
		<div class="tool__download">
			<Label>
				Download 3D Files
			</Label>
			{downloadLayout === 'buttons' && downloads.length > 0 && (
				<div class="tool__actions">
					{downloads.map((file) => {
						const isExternal = isExternalUrl(file.href);
						return (
							<Button
								href={file.href}
								download={!isExternal}
								target={isExternal ? '_blank' : undefined}
							>
								{file.format}
							</Button>
						);
					})}
				</div>
			)}
		</div>
		{(downloadFiles || downloadLayout === 'list') && (
			<div class="tools__list">
				<Label>
					Standalone files
				</Label>
				<ul class="tool__download-list">
					{(downloadFiles || downloads).map((file) => {
						const isExternal = isExternalUrl(file.href);
						return (
							<li class="tool__download-item">
								<Link
									href={file.href}
									download={!isExternal}
									target={isExternal ? '_blank' : undefined}
								>
									{file.format}
								</Link>
							</li>
						);
					})}
				</ul>
			</div>
		)}
		{license && (
			<div class="tool__license">
				<Label>
					License
				</Label>
				<div class="tool__license-text">
					<Link href={license.href} target="_blank" rel="noopener noreferrer">
						{license.title}
					</Link>
				</div>
			</div>
		)}
	</div>
</article>

<script>
	import PhotoSwipeLightbox from 'photoswipe/lightbox';

	function initPhotoSwipe() {
		const lightbox = new PhotoSwipeLightbox({
			gallery: '.tool__gallery',
			children: 'a',
			pswpModule: () => import('photoswipe'),
		});
		lightbox.init();
	}

	initPhotoSwipe();
	document.addEventListener('astro:page-load', initPhotoSwipe);
</script>
