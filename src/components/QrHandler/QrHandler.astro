---
import './QrHandler.css';
import Icon from '../Icon/Icon.astro';

export type QrOption = 'tiktok' | 'telegram-en' | 'telegram-ru';

interface Props {
	option: QrOption;
}

const { option } = Astro.props;
const modalId = `#qr-modal-${option}`;
---

<a class="qr-handler" data-hystmodal={modalId} href={modalId} aria-label={`Open QR code for ${option}`}><Icon class="qr-handler__icon" name="qr_code" /></a>

