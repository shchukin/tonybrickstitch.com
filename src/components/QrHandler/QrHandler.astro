---
import './QrHandler.css';
import AppIcon from '../AppIcon/AppIcon.astro';

export type QrOption = 'tiktok' | 'telegram-en' | 'telegram-ru';

interface Props {
	option: QrOption;
}

const { option } = Astro.props;
const modalId = `#qr-modal-${option}`;
---

<button class="qr-handler" type="button" data-hystmodal={modalId} aria-label={`Open QR code for ${option}`}>
    <AppIcon class="qr-handler__icon" name="qr" />
</button>
