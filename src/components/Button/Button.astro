---
import './Button.css';

interface Props {
	href?: string;
	target?: string;
	rel?: string;
	secondary?: boolean;
	square?: boolean;
	type?: 'button' | 'submit';
	[key: string]: unknown;
}

const {
	href,
	target,
	rel,
	secondary,
	square,
	type = 'button',
	...rest
} = Astro.props;

const Tag = href ? 'a' : 'button';
const computedRel = rel ?? (target === '_blank' ? 'noopener noreferrer' : undefined);

const classes = [
	'button',
	secondary && 'button--secondary',
	square && 'button--square',
].filter(Boolean).join(' ');
---

<Tag
	href={Tag === 'a' ? href : undefined}
	target={Tag === 'a' ? target : undefined}
	rel={Tag === 'a' ? computedRel : undefined}
	type={Tag === 'button' ? type : undefined}
	class={classes}
	{...rest}
>
	<slot />
</Tag>
