---
import './Follow.css';
import Link from "../Link/Link.astro";
import Title from "../Title/Title.astro";
import Wysiwyg from "../Wysiwyg/Wysiwyg.astro";
---


<div class="follow">
    <div class="follow__heading">
        <Title as="h2">Follow me</Title>
    </div>
    <div class="follow__content">
        <Wysiwyg halved>
            <p>
                Please follow me on <Link href="http://tiktok.com/@tonybrickstitch">TikTok</Link> for my works showcase.
            </p>
            <p>
                Subscribe to the Telegram channel for tips and tricks and the personal blog:<br>
                <Link href="https://t.me/TonyBrickStitch">Telegram in English</Link> &nbsp;•&nbsp; <Link href="https://t.me/TonyBrickStitchRu">Телеграм на русском</Link><br>
                You can also message me via private message right into this channel.
            </p>
        </Wysiwyg>
    </div>
</div>
