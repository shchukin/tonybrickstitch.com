---
import './Follow.css';
import Link from "../Link/Link.astro";
import Title from "../Title/Title.astro";
import Wysiwyg from "../Wysiwyg/Wysiwyg.astro";
import QrHandler from "../QrHandler/QrHandler.astro";
import QrModalTiktok from "../QrModalTiktok/QrModalTiktok.astro";
import QrModalTelegram from "../QrModalTelegram/QrModalTelegram.astro";
import { socialNetworksData } from "../../data/socialNetworks";
import Nobr from "../Nobr/Nobr.astro";
import TelegramChannels from "../TelegramChannels/TelegramChannels.astro";

const tiktokLink = socialNetworksData.tiktok.link;
const telegramEnLink = socialNetworksData['telegram-en'].link;
const telegramRuLink = socialNetworksData['telegram-ru'].link;
---


<div class="follow">
    <div class="follow__heading">
        <Title as="h2">Follow me</Title>
    </div>
    <div class="follow__content">
        <Wysiwyg halved>
            <p>
                Check out my <Nobr><Link href={tiktokLink}>TikTok</Link> <QrHandler option="tiktok" /></Nobr> for short videos of my latest pieces.
            </p>
            <p>
                Join my Telegram channel for tips, tricks, and a personal blog:<br>
                <TelegramChannels telegramEnLink={telegramEnLink} telegramRuLink={telegramRuLink} />
            </p>
            <p>
                To contact me, please send a direct message right into the Telegram channel.
            </p>
        </Wysiwyg>
    </div>
    <QrModalTiktok data={socialNetworksData.tiktok} />
    <QrModalTelegram data={socialNetworksData['telegram-en']} />
    <QrModalTelegram data={socialNetworksData['telegram-ru']} />
</div>
