---
import Window from '../Window/Window.astro';
import HystModal from '../HystModal/HystModal.astro';
import QrTiktok from '../QrModalTiktok/QrModalTiktok.astro';
import QrModalTelegram from '../QrModalTelegram/QrModalTelegram.astro';

export type QrOption = 'tiktok' | 'telegram-en' | 'telegram-ru';

interface Props {
	option: QrOption;
}

const { option } = Astro.props;

const optionsData = {
	tiktok: {
		id: 'qr-modal-tiktok',
		qrImage: '/images/tiktok.png',
		username: '@tonybrickstitch',
		link: 'https://www.tiktok.com/@tonybrickstitch',
		label: 'TonyBrickStitch on TikTok',
	},
	'telegram-en': {
		id: 'qr-modal-telegram-en',
		qrImage: '/images/telegram-en.jpg',
		username: '@TonyBrickStitch',
		usernameFontSize: 22,
		link: 'https://t.me/TonyBrickStitch',
		label: 'TonyBrickStitch’s Telegram Channel',
	},
	'telegram-ru': {
		id: 'qr-modal-telegram-ru',
		qrImage: '/images/telegram-ru.jpg',
		username: '@TonyBrickStitchRu',
		usernameFontSize: 20,
		link: 'https://t.me/TonyBrickStitchRu',
		label: 'Телеграм канал TonyBrickStitch',
	},
};

const data = optionsData[option];
---

<HystModal id={data.id}>
	<Window>
		{option === 'tiktok' ? (
			<QrTiktok qrImage={data.qrImage} title={'TonyBrickStitch'} username={data.username} label={data.label} link={data.link} />
		) : (
			<QrModalTelegram qrImage={data.qrImage} username={data.username} usernameFontSize={data.usernameFontSize} label={data.label} link={data.link} />
		)}
	</Window>
</HystModal>
