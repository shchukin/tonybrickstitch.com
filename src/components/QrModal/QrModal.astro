---
import './QrModal.css';
import Window from '../Window/Window.astro';
import QrTiktok from '../QrModalTiktok/QrModalTiktok.astro';
import QrTelegram from './QrTelegram.astro';

export type QrOption = 'tiktok' | 'telegram-en' | 'telegram-ru';

interface Props {
	option: QrOption;
}

const { option } = Astro.props;

const optionsData = {
	tiktok: {
		id: 'qr-modal-tiktok',
		qrImage: '/images/tiktok.png',
		username: '@tonybrickstitch',
		label: 'TonyBrickStitch on TikTok',
	},
	'telegram-en': {
		id: 'qr-modal-telegram-en',
		qrImage: '/images/telegram-en.jpg',
		username: '@TonyBrickStitch',
		label: 'TonyBrickStitch’s Telegram Channel',
	},
	'telegram-ru': {
		id: 'qr-modal-telegram-ru',
		qrImage: '/images/telegram-ru.jpg',
		username: '@TonyBrickStitchRu',
		label: 'Телеграм канал TonyBrickStitch',
	},
};

const data = optionsData[option];
---

<div class="hystmodal" id={data.id} aria-hidden="true">
	<div class="hystmodal__wrap">
		<div class="hystmodal__window" role="dialog">
			<Window>
				{option === 'tiktok' ? (
					<QrTiktok qrImage={data.qrImage} username={data.username} label={data.label} />
				) : (
					<QrTelegram qrImage={data.qrImage} username={data.username} label={data.label} />
				)}
			</Window>
		</div>
	</div>
</div>
