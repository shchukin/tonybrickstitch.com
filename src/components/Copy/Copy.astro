---

import './Copy.css';

interface Props {
  textToCopy: string;
  buttonText?: string;
  copiedText?: string;
  className?: string;
}

const {
  textToCopy,
  buttonText = "Copy",
  copiedText = "Copied!",
  className = "",
} = Astro.props;
---

<button
    class={`copy ${className}`}
    data-clipboard-text={textToCopy}
    data-default-text={buttonText}
    data-copied-text={copiedText}
    type="button"
>
    {buttonText}
</button>

<script>
  function setupCopyButtons() {
    const buttons = document.querySelectorAll<HTMLButtonElement>(".copy");

    buttons.forEach((button) => {
      if (button.dataset.initialized) return;
      button.dataset.initialized = "true";

      button.addEventListener("click", async () => {
        const text = button.dataset.clipboardText;
        const defaultText = button.dataset.defaultText || "Copy";
        const copiedText = button.dataset.copiedText || "Copied!";

        if (!text) return;

        try {
          await navigator.clipboard.writeText(text);
          button.textContent = copiedText;
          button.classList.add("copy--is-copied");

          setTimeout(() => {
            button.textContent = defaultText;
            button.classList.remove("copy--is-copied");
          }, 2000);
        } catch (err) {
          alert("Failed to copy text. Please try again or manually select and copy the text.");
        }
      });
    });
  }

  setupCopyButtons();
  document.addEventListener("astro:page-load", setupCopyButtons);
</script>
