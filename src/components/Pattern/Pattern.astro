---
import './Pattern.css';
import Link from '../Link/Link.astro';
import Wysiwyg from '../Wysiwyg/Wysiwyg.astro';
import Button from '../Button/Button.astro';
import Icon from '../Icon/Icon.astro';
import type { PatternData } from '../../types/pattern';
import Label from "../Label/Label.astro";
import Image from '../Image/Image.astro';

interface Props extends PatternData {}

const { alias, title, description, author, previewImage } = Astro.props;

const modalId = `#share-${alias}`;
const pdfEn = `/patterns/${alias}-en.pdf`;
const pdfRu = `/patterns/${alias}-ru.pdf`;
---

<article class="pattern">
	<a class="pattern__preview" href={pdfEn}>
		<Image class="pattern__image" src={previewImage} width="280" height="210" alt={`Preview image for pattern: ${title}`} />
	</a>
	<div class="pattern__body">
		<h3 class="pattern__heading">
			{title}
		</h3>
		<div class="pattern__description">
			<Wysiwyg smaller set:html={description} />
		</div>
	</div>
	<div class="pattern__sidebar">
		{author && (
			<div class="pattern__original">
				<Label>
					{ author.label }
				</Label>
				<div class="pattern__author">
					<Link href={author.href}>{author.name}</Link>
				</div>
			</div>
		)}
		<div class="pattern__download">
			<Label>
				Beading Mods
			</Label>
			<div class="pattern__actions">
				<div class="pattern__main-link">
					<Button href={pdfEn}>Download PDF</Button>
				</div>
				<div class="pattern__share">
					<Button secondary square type="button" data-hystmodal={modalId} aria-label="Share pattern">
						<Icon name="ios_share" />
					</Button>
				</div>
			</div>
			<div class="pattern__alt-link">
				<Link href={pdfRu}>Русская версия</Link>
			</div>
		</div>
		<div class="pattern__printing-hint">
			Select <strong class="pattern__highlight">Scale to fit</strong> when printing
		</div>
	</div>
</article>
