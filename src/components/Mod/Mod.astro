---
import './Mod.css';
import Link from '../Link/Link.astro';
import Wysiwyg from '../Wysiwyg/Wysiwyg.astro';
import Button from '../Button/Button.astro';
import type { ModData } from '../../types/mod';

interface Props extends ModData {}

const { alias, title, description, author } = Astro.props;

const pdfEn = `/patterns/${alias}-en.pdf`;
const pdfRu = `/patterns/${alias}-ru.pdf`;
const previewImage = `/content/mods/${alias}-pattern-mods-preview.jpg`;
---

<article class="mod">
	<a class="mod__preview" href={pdfEn}>
		<img class="mod__image" src={previewImage} width="280" height="210" alt="">
	</a>
	<div class="mod__body">
		<h3 class="mod__heading">
			{title}
		</h3>
		<div class="mod__description">
			<Wysiwyg smaller>
				<ul>
					{description.map((item) => <li>{item}</li>)}
				</ul>
			</Wysiwyg>
		</div>
	</div>
	<div class="mod__sidebar">
		<div class="mod__original">
			<div class="label">
				Original design
			</div>
			<div class="mod__author">
				<Link href={author.href}>{author.name}</Link>
			</div>
		</div>
		<div class="mod__download">
			<div class="label">
				Mods
			</div>
			<div class="mod__actions">
				<div class="mod__main-link">
					<Button href={pdfEn}>Download PDF</Button>
				</div>
				<div class="mod__share">
					<Button secondary square type="button">
						<svg class="button__icon" width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
							<path stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" d="M15 6L12 3L9 6M12 3V13M7.00023 10C6.06835 10 5.60241 10 5.23486 10.1522C4.74481 10.3552 4.35523 10.7448 4.15224 11.2349C4 11.6024 4 12.0681 4 13V17.8C4 18.9201 4 19.4798 4.21799 19.9076C4.40973 20.2839 4.71547 20.5905 5.0918 20.7822C5.5192 21 6.07899 21 7.19691 21H16.8036C17.9215 21 18.4805 21 18.9079 20.7822C19.2842 20.5905 19.5905 20.2839 19.7822 19.9076C20 19.4802 20 18.921 20 17.8031V13C20 12.0681 19.9999 11.6024 19.8477 11.2349C19.6447 10.7448 19.2554 10.3552 18.7654 10.1522C18.3978 10 17.9319 10 17 10"/>
						</svg>
					</Button>
				</div>
			</div>
			<div class="mod__alt-link">
				<Link href={pdfRu}>Русская версия</Link>
			</div>
		</div>
		<div class="mod__printing-hint">
			Select <strong class="mod__highlight">Scale to fit</strong> when printing
		</div>
	</div>
</article>
