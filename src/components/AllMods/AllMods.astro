---
import './AllMods.css';
import Title from '../Title/Title.astro';
import Wysiwyg from '../Wysiwyg/Wysiwyg.astro';
import Mod from '../Mod/Mod.astro';
import Share from '../Share/Share.astro';
import HystModalInit from '../HystModalInit/HystModalInit.astro';
import type { ModData } from '../../types/mod';

interface Props {
	mods: ModData[];
}

const { mods } = Astro.props;
---

<div class="all-mods">
	<div class="all-mods__heading">
		<Title as="h2">Pattern modifications</Title>
	</div>
	<div class="all-mods__description">
		<Wysiwyg halved>
			<p>
				When crafting with seed beads, I often work with non-beading patterns. It can be a friendship bracelet pattern
				from <a href="https://www.braceletbook.com">Bracelet Book</a> or retro pixel art. These designs usually require
				a few tweaks: adding or trimming rows, adjusting proportions to fit the seed beads aspect ratio, picking the
				bead colors, and so forth.
			</p>
			<p>
				I compile these modifications into PDF files and share them just like the originals: non-commercial and completely free.
				These mods are created with a community-driven mindset, much like open-source software.
			</p>
			<p>
				Design authors are credited.
			</p>
		</Wysiwyg>
	</div>
	<div class="all-mods__list">
		{mods.map((mod) => <Mod {...mod} />)}
	</div>
	{mods.map((mod) => <Share {...mod} />)}
	<HystModalInit />
</div>
