---
import './Library.css';
import Title from '../Title/Title.astro';
import Wysiwyg from '../Wysiwyg/Wysiwyg.astro';
import Pattern from '../Pattern/Pattern.astro';
import Share from '../Share/Share.astro';
import HystModalInit from '../HystModalInit/HystModalInit.astro';
import type { PatternData } from '../../types/pattern';
import Link from "../Link/Link.astro";

interface Props {
	patterns: PatternData[];
}

const { patterns } = Astro.props;
---

<div class="library">
	<div class="library__heading">
		<Title as="h2">Beading patterns</Title>
	</div>
	<div class="library__description">
		<Wysiwyg halved>
			<p>
				When crafting with seed beads, I often adapt non‑beading patterns—like friendship bracelet charts
				from <Link href="https://www.braceletbook.com" target="_blank">Bracelet Book</Link> or retro pixel art. These designs usually need
				a few tweaks: adding or removing rows, adjusting proportions to fit the seed bead aspect ratio, and fine-tuning
				color palettes.
			</p>
			<p>
				I compile these modded charts into PDF files and share them just like the originals: non-commercial and completely free.
				These mods are created with a community-driven mindset, much like open‑source software.
			</p>
			<p>
				Original design authors are always credited.
			</p>
		</Wysiwyg>
	</div>
	<div class="library__list">
		{patterns.map((pattern) => <Pattern {...pattern} />)}
	</div>
	{patterns.map((pattern) => <Share {...pattern} />)}
	<HystModalInit />
</div>
