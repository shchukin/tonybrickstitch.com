---
import './Library.css';
import Title from '../Title/Title.astro';
import Wysiwyg from '../Wysiwyg/Wysiwyg.astro';
import Pattern from '../Pattern/Pattern.astro';
import Share from '../Share/Share.astro';
import HystModalInit from '../HystModalInit/HystModalInit.astro';
import type { PatternData } from '../../types/pattern';

interface Props {
	title: string;
	patterns: PatternData[];
}

const { title, patterns } = Astro.props;

if (patterns.length === 0) return;
---

<div class="library">
	<div class="library__heading">
		<Title as="h2">{title}</Title>
	</div>
	<div class="library__description">
		<Wysiwyg halved>
			<slot name="description" />
		</Wysiwyg>
	</div>
	<div class="library__list">
		{patterns.map((pattern) => <Pattern {...pattern} />)}
	</div>
	{patterns.map((pattern) => <Share {...pattern} />)}
	<HystModalInit />
</div>
