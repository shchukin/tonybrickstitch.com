---
import './QrModalTelegram.css';
import logoImg from '../../assets/images/logo.png';
import beachSvg from './beach.svg?url';
import snowflakesSvg from './snowflakes.svg?url';
import AppImage from "../AppImage/AppImage.astro";
import Link from "../Link/Link.astro";
import HystModal from "../HystModal/HystModal.astro";
import Window from "../Window/Window.astro";
import type { SocialNetworkData } from "../../data/socialNetworks";

interface Props {
	data: SocialNetworkData;
}

const { data } = Astro.props;
const { id, qrImage, username, usernameFontSize = 22, label, link } = data;
const isEn = id.includes('en');
---

{isEn ? (
	<link rel="preload" href={beachSvg} as="image" type="image/svg+xml" />
) : (
	<link rel="preload" href={snowflakesSvg} as="image" type="image/svg+xml" />
)}

<HystModal id={id}>
	<Window>
		<div class:list={['qr-modal-telegram', id && `qr-modal-telegram--${id}`]}>
			<AppImage class="qr-modal-telegram__logo" src={logoImg} width="108" height="108" alt="Tony Brick Stitch Logo" />
			<img class="qr-modal-telegram__image" src={qrImage} alt={`QR code for ${label}`} />
			<a class="qr-modal-telegram__username" style={`font-size: ${usernameFontSize}px`} href={link} target="_blank">
				@<span class="qr-modal-telegram__hover">{username}</span>
			</a>
		</div>
	</Window>
</HystModal>
