---
import './Window.css';
import AppIcon from '../AppIcon/AppIcon.astro';
import Title from "../Title/Title.astro";

interface Props {
  heading?: string;
  floatedCrossButton?: boolean;
}

const { heading, floatedCrossButton } = Astro.props;
---

<div class:list={['window', { 'window--floated-cross-button': floatedCrossButton }]}>
  <button class="window__close" type="button" data-hystclose>
    <AppIcon name="close"/>
  </button>
  {heading && (
    <div class="window__heading">
      <Title>
        {heading}
      </Title>
    </div>
  )}
    <div class="window__body">
      <slot/>
    </div>
</div>
