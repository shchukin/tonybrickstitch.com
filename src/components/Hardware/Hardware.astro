---
import './Hardware.css';
import Title from '../Title/Title.astro';
import Wysiwyg from '../Wysiwyg/Wysiwyg.astro';
import Tool from '../Tool/Tool.astro';
import type { ToolData } from '../../types/tool';

interface Props {
	tools: ToolData[];
}

const { tools } = Astro.props;
---

<div class="hardware">
	<div class="hardware__heading">
		<Title as="h2">3D Tools</Title>
	</div>
	<div class="hardware__description">
		<Wysiwyg halved>
			<p>
				Here are a couple of basic tools I designed for myself, but you can easily print them as well.
				Search for nearby <strong><em>3D printing services</em></strong> in your maps app and send them the STL files or a link to this page.
				They should be able to print them for just a few dollars.
			</p>
		</Wysiwyg>
	</div>
	<div class="hardware__list">
		{tools.map((tool) => <Tool {...tool} />)}
	</div>
</div>
