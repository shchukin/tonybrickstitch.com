---
import { Image } from 'astro:assets';
import logoImg from '../../assets/images/logo.png';
import './Intro.css';
---

<div class="intro">
    <div class="intro__head">
        <Image class="intro__logo" src={logoImg} alt="Tony Brick Stitch Logo" />
        <h1 class="intro__heading">
            Tony Brick Stitch
        </h1>
    </div>
    <div class="intro__content">
        <div class="wysiwyg wysiwyg--halved">
            <p>Hi, I’m Tony! I create things using seed beads.</p>
        </div>
    </div>
</div>
